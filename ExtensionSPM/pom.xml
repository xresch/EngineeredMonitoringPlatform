<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.xresch</groupId>
	<artifactId>emp-extension-spm</artifactId>
	<version>1.0.0</version>

	<!-- ================= PROPERTIES ================== -->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		
		<folderName>EMPServer</folderName> <!-- making folder without version name, as antrun can't handle regex with folders -->
		<binariesFolder>${basedir}/target/${folderName}</binariesFolder>
		
		<releaseName>EMPServer_v${project.version}</releaseName> <!-- making versioned folder for zipping -->
		<zipFolder>${basedir}/target/${releaseName}</zipFolder>
		
		<skipMakeFolder>false</skipMakeFolder>
		
	</properties>

	<!-- ================= DEPENDENCIES ================== -->
	<dependencies>

		<!-- https://mvnrepository.com/artifact/com.xresch/cfw -->
		<dependency>
			<groupId>com.xresch</groupId>
			<artifactId>cfw</artifactId>
			<version>11.11.11</version>
			<scope>provided</scope>
		</dependency>
		
		<!-- local build -->
		<dependency>
			<groupId>com.xresch</groupId>
			<artifactId>emp</artifactId>
			<version>4.6.8</version>
			<scope>provided</scope>
		</dependency>
		
	</dependencies>


	<!-- ================= BUILD ================== -->
	<build>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
		</resources>

		<plugins>
			<!-- ================= COMPILER ================== -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.0</version>
				<configuration>
					<source>17</source>
					<target>17</target>
				</configuration>
			</plugin>
			
			<!-- ================= DEPENDENCY ================== -->
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<excludeScope>provided</excludeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>
						
		</plugins>

	</build>
</project>